# Server Configuration
APP_HOST=127.0.0.1
APP_PORT=8002
APP_RELOAD=true

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=crawl-careers

# PostgreSQL Configuration
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_db

# Milvus Configuration
MILVUS_URL=your_milvus_url
MILVUS_TOKEN=your_milvus_token
MILVUS_COLLECTION=jobs_multi_vector

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-m3
HF_TOKEN=your_hf_token

# Directory Paths
UPLOAD_DIR=data/cvs
CV_TEXT_LOG_DIR=data/log-cv-to-text
MAX_UPLOAD_SIZE=10485760

# CORS
ALLOWED_ORIGINS=*

# Matching Weights (Total must be 1.0)
WEIGHT_TITLE=0.10
WEIGHT_TECH=0.40
WEIGHT_MOTA=0.25
WEIGHT_LOCATION=0.15
WEIGHT_EXPERIENCE=0.10

# Redis Configuration
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_USERNAME=default
REDIS_DB=0

# Cache Settings
CACHE_ENABLED=true
JOBS_CACHE_TTL=3600
MATCH_CACHE_TTL=1800

# Logging
LOG_LEVEL=INFO

# Gemini LLM (CV Parser - LLM Strategy)
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-2.0-flash

# Groq LLM Settings
GROQ_API_KEY=your_api_key
GROQ_MODEL=llama-3.3-70b-versatile